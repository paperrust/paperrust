{
  "name": "paperrust-frontend-light",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "i18n:check": "node tools/i18n-check.mjs",
    "build": "node tools/icons.mjs && node tools/i18n-check.mjs && node tools/i18n-split.mjs && vite build && node tools/compress.mjs",
    "budget": "node tools/budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "visual": "node tests/visual/compare.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "pdfjs-dist": "6.5.438",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "postcss": "8.5.33",
    "sass": "1.108.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperRust",
  "version": "0.1.2",
  "identifier": "ch.paperrust.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: prapi: http://prapi.localhost; connect-src ipc: http://ipc.localhost prapi: http://prapi.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}

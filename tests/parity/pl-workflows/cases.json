{
  "crate": "pl-workflows",
  "vars": {
    "workflow_id": {"get": "/api/workflows/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "trigger_id": {"get": "/api/workflow_triggers/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "action_id": {"get": "/api/workflow_actions/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "tag_id": {"get": "/api/tags/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "corr_id": {"get": "/api/correspondents/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "cf_id": {"get": "/api/custom_fields/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"}
  },
  "defaults": {"users": ["admin"], "api_versions": ["10"]},
  "cases": [
    {"id": "wf.triggers.create.ok", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 1, "sources": [2, 2, "3"], "filter_filename": "  *.pdf ", "filter_path": ""},
     "users": ["admin", "user1", "noperm", "anon"], "write": true},
    {"id": "wf.triggers.create.defaults", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 4, "schedule_offset_days": "-5", "schedule_is_recurring": "yes"}, "write": true},
    {"id": "wf.triggers.create.consumption-nofilter", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 1, "sources": [1]}, "write": true},
    {"id": "wf.triggers.create.badfields", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": "x", "sources": "1", "filter_has_tags": [999999], "filter_has_correspondent": "abc",
              "schedule_recurring_interval_days": 0, "matching_algorithm": 6, "is_insensitive": "maybe",
              "filter_mailrule": true, "schedule_date_field": "foo", "match": 5},
     "write": true},
    {"id": "wf.triggers.create.notype", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"sources": [2]}, "write": true},
    {"id": "wf.triggers.create.cfq-json", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 2, "filter_custom_field_query": "[not json"}, "write": true},
    {"id": "wf.triggers.create.cfq-shape", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 2, "filter_custom_field_query": "[\"AND\", [[999999, \"exact\", 1], \"x\"]]"}, "write": true},
    {"id": "wf.triggers.create.cfq-op", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 2, "filter_custom_field_query": "[\"XOR\", []]"}, "write": true},
    {"id": "wf.triggers.create.cfq-ok", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": {"type": 2, "filter_custom_field_query": "[\"OR\", [[${cf_id}, \"exists\", true], [\"NOT\", [${cf_id}, \"isnull\", false]]]]"},
     "write": true, "requires": ["cf_id"]},
    {"id": "wf.triggers.create.list-body", "route": "workflow_triggers.create", "method": "POST", "path": "/api/workflow_triggers/",
     "json": [1, 2], "write": true},
    {"id": "wf.triggers.patch.ok", "route": "workflow_triggers.partial_update", "method": "PATCH", "path": "/api/workflow_triggers/${trigger_id}/",
     "json": {"id": "${trigger_id}", "filter_filename": "patched.pdf", "filter_has_tags": ["${tag_id}"]},
     "users": ["admin", "noperm"], "write": true, "requires": ["trigger_id", "tag_id"]},
    {"id": "wf.triggers.patch.idmismatch", "route": "workflow_triggers.partial_update", "method": "PATCH", "path": "/api/workflow_triggers/${trigger_id}/",
     "json": {"id": 999999, "filter_filename": "x"}, "write": true, "requires": ["trigger_id"]},
    {"id": "wf.triggers.patch.idmismatch-missing", "route": "workflow_triggers.partial_update", "method": "PATCH", "path": "/api/workflow_triggers/999999/",
     "json": {"id": 5}, "write": true},
    {"id": "wf.triggers.put.missing-type", "route": "workflow_triggers.update", "method": "PUT", "path": "/api/workflow_triggers/${trigger_id}/",
     "json": {"filter_filename": "x"}, "write": true, "requires": ["trigger_id"]},
    {"id": "wf.triggers.delete", "route": "workflow_triggers.destroy", "method": "DELETE", "path": "/api/workflow_triggers/${trigger_id}/",
     "users": ["admin", "noperm"], "write": true, "requires": ["trigger_id"]},

    {"id": "wf.actions.create.ok", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"assign_title": "{{ correspondent }} {{ created_year }}", "assign_tags": ["${tag_id}", "${tag_id}"],
              "assign_correspondent": "${corr_id}", "assign_custom_fields_values": {"1": "", "2": 0}},
     "users": ["admin", "noperm"], "write": true, "requires": ["tag_id", "corr_id"]},
    {"id": "wf.actions.create.title-syntax", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"assign_title": "{{created_year}"}, "write": true},
    {"id": "wf.actions.create.title-filter", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"assign_title": "a\n{{ created_year | foo }}"}, "write": true},
    {"id": "wf.actions.create.title-unknown", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"assign_title": "{{ creation_year }}"}, "write": true},
    {"id": "wf.actions.create.email-missing", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 3}, "write": true},
    {"id": "wf.actions.create.email-nested", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 3, "email": {"subject": "s", "body": "b", "to": "a@example.com"}}, "write": true, "compare": "status"},
    {"id": "wf.actions.create.email-invalid", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 3, "email": {"subject": ""}}, "write": true},
    {"id": "wf.actions.create.webhook-url", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 4, "webhook": {"url": "ftp://example.com/x"}}, "write": true},
    {"id": "wf.actions.create.passwords", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 5, "passwords": ["", "pw"]}, "write": true},
    {"id": "wf.actions.create.passwords-ok", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 5, "passwords": ["pw1", "pw2"]}, "write": true, "leak_allow": ["password"]},
    {"id": "wf.actions.create.ai-fields", "route": "workflow_actions.create", "method": "POST", "path": "/api/workflow_actions/",
     "json": {"type": 8, "ai_suggestion_fields": ["title", "nope"]}, "write": true},
    {"id": "wf.actions.patch.ok", "route": "workflow_actions.partial_update", "method": "PATCH", "path": "/api/workflow_actions/${action_id}/",
     "json": {"assign_title": "Patched", "remove_all_tags": true}, "write": true, "requires": ["action_id"]},
    {"id": "wf.actions.put", "route": "workflow_actions.update", "method": "PUT", "path": "/api/workflow_actions/${action_id}/",
     "json": {"type": 2, "remove_tags": ["${tag_id}"]}, "write": true, "requires": ["action_id", "tag_id"]},
    {"id": "wf.actions.delete", "route": "workflow_actions.destroy", "method": "DELETE", "path": "/api/workflow_actions/${action_id}/",
     "write": true, "requires": ["action_id"]},

    {"id": "wf.create.nested", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": {"name": "parity wf", "order": 3,
              "triggers": [{"type": 1, "sources": [2], "filter_filename": "*.pdf", "filter_has_tags": ["${tag_id}"]},
                           {"type": 3, "filter_has_any_correspondents": ["${corr_id}"]}],
              "actions": [{"assign_title": "T {{ doc_id }}", "assign_tags": ["${tag_id}"]},
                          {"type": 3, "email": {"subject": "S", "body": "B", "to": "x@example.com", "include_document": true}},
                          {"type": 4, "webhook": {"url": "https://example.com/hook", "params": {"a": "b"}, "headers": {"X": "1"}}},
                          {"type": 2, "remove_all_tags": true}]},
     "users": ["admin", "user1", "noperm"], "write": true, "requires": ["tag_id", "corr_id"]},
    {"id": "wf.create.errors", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": {"name": "", "order": "x", "triggers": [{"type": 2}, {"type": 9}], "actions": {"a": 1}}, "write": true},
    {"id": "wf.create.required", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": {}, "write": true},
    {"id": "wf.create.null", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": null, "content_type": "application/json", "data": "null", "write": true},
    {"id": "wf.create.remote-ocr", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": {"name": "ocr", "triggers": [{"type": 2}], "actions": [{"type": 7}]}, "write": true},
    {"id": "wf.create.ai-consumption", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "json": {"name": "ai", "triggers": [{"type": 1, "filter_filename": "*"}], "actions": [{"type": 8, "ai_suggestion_fields": ["title"]}]},
     "write": true},
    {"id": "wf.create.dupname", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "steps": [
       {"method": "POST", "path": "/api/workflows/", "json": {"name": "dup", "triggers": [], "actions": []}},
       {"method": "POST", "path": "/api/workflows/", "json": {"name": "dup", "triggers": [], "actions": []}}
     ], "write": true},
    {"id": "wf.patch.name", "route": "workflows.partial_update", "method": "PATCH", "path": "/api/workflows/${workflow_id}/",
     "json": {"name": "renamed wf", "enabled": false}, "users": ["admin", "noperm"], "write": true, "requires": ["workflow_id"]},
    {"id": "wf.patch.empty-actions", "route": "workflows.partial_update", "method": "PATCH", "path": "/api/workflows/${workflow_id}/",
     "json": {"actions": []}, "write": true, "requires": ["workflow_id"]},
    {"id": "wf.patch.replace-triggers", "route": "workflows.partial_update", "method": "PATCH", "path": "/api/workflows/${workflow_id}/",
     "json": {"triggers": [{"type": 2, "filter_has_tags": ["${tag_id}"]}]}, "write": true, "requires": ["workflow_id", "tag_id"],
     "steps": [
       {"method": "PATCH", "path": "/api/workflows/${workflow_id}/", "json": {"triggers": [{"type": 2, "filter_has_tags": ["${tag_id}"]}]}},
       {"method": "GET", "path": "/api/workflow_triggers/"},
       {"method": "GET", "path": "/api/workflow_actions/"}
     ]},
    {"id": "wf.patch.partial-email", "route": "workflows.partial_update", "method": "PATCH", "path": "/api/workflows/${workflow_id}/",
     "json": {"actions": [{"type": 3, "email": {"subject": "only subject"}}]}, "write": true, "requires": ["workflow_id"]},
    {"id": "wf.put.missing", "route": "workflows.update", "method": "PUT", "path": "/api/workflows/${workflow_id}/",
     "json": {"name": "x"}, "write": true, "requires": ["workflow_id"]},
    {"id": "wf.delete", "route": "workflows.destroy", "method": "DELETE", "path": "/api/workflows/${workflow_id}/",
     "users": ["admin", "noperm", "anon"], "write": true, "requires": ["workflow_id"],
     "steps": [
       {"method": "DELETE", "path": "/api/workflows/${workflow_id}/"},
       {"method": "GET", "path": "/api/workflows/${workflow_id}/"},
       {"method": "GET", "path": "/api/workflow_triggers/"}
     ]},
    {"id": "wf.create.form-body", "route": "workflows.create", "method": "POST", "path": "/api/workflows/",
     "form": {"name": "form"}, "write": true, "skip": "Known difference: Form-Bodies (Rust: 415)"}
  ]
}

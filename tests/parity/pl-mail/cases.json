{
  "crate": "pl-mail",
  "vars": {
    "account_id": {"get": "/api/mail_accounts/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "rule_id": {"get": "/api/mail_rules/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"},
    "pm_id": {"get": "/api/processed_mail/", "query": {"page_size": 1}, "user": "admin", "json": "results.0.id"}
  },
  "defaults": {"users": ["admin"], "api_versions": ["10"]},
  "cases": [
    {"id": "mail.accounts.list.full_perms", "route": "mail_accounts.list", "method": "GET", "path": "/api/mail_accounts/",
     "query": {"full_perms": "true"}, "users": ["admin", "user1", "user2"], "api_versions": ["10", "9"]},
    {"id": "mail.accounts.list.page2", "route": "mail_accounts.list", "method": "GET", "path": "/api/mail_accounts/",
     "query": {"page": 2, "page_size": 1}, "users": ["admin", "user1"]},
    {"id": "mail.accounts.retrieve.nonint", "route": "mail_accounts.retrieve", "method": "GET", "path": "/api/mail_accounts/abc/",
     "users": ["admin", "user1"]},
    {"id": "mail.accounts.retrieve.missing", "route": "mail_accounts.retrieve", "method": "GET", "path": "/api/mail_accounts/999999/",
     "users": ["admin", "user1"]},
    {"id": "mail.rules.list.full_perms", "route": "mail_rules.list", "method": "GET", "path": "/api/mail_rules/",
     "query": {"full_perms": "1"}, "users": ["admin", "user1", "user2"], "api_versions": ["10", "9"]},
    {"id": "mail.processed.filter.rule_invalid", "route": "processed_mail.list", "method": "GET", "path": "/api/processed_mail/",
     "query": {"rule": "abc"}, "users": ["admin", "user1"]},
    {"id": "mail.processed.filter.rule_missing", "route": "processed_mail.list", "method": "GET", "path": "/api/processed_mail/",
     "query": {"rule": 999999}, "users": ["admin"]},
    {"id": "mail.processed.filter.rule", "route": "processed_mail.list", "method": "GET", "path": "/api/processed_mail/",
     "query": {"rule": "${rule_id}"}, "users": ["admin", "user1"], "requires": ["rule_id"]},
    {"id": "mail.processed.ordering", "route": "processed_mail.list", "method": "GET", "path": "/api/processed_mail/",
     "query": {"ordering": "-received,id,bogus"}, "users": ["admin", "user1"]},
    {"id": "mail.processed.retrieve.filtered", "route": "processed_mail.retrieve", "method": "GET", "path": "/api/processed_mail/${pm_id}/",
     "query": {"status": "NOPE"}, "users": ["admin"], "requires": ["pm_id"]},

    {"id": "mail.accounts.create.invalid", "route": "mail_accounts.create", "method": "POST", "path": "/api/mail_accounts/",
     "json": {"name": "", "imap_server": [1], "imap_port": "x", "imap_security": 9, "username": null, "password": "   ",
              "is_token": "maybe", "owner": "abc", "account_type": true, "expiration": "gestern"},
     "users": ["admin", "noperm"], "write": true},
    {"id": "mail.accounts.create.ok", "route": "mail_accounts.create", "method": "POST", "path": "/api/mail_accounts/",
     "json": {"name": "parity-acc", "imap_server": "imap.example.invalid", "imap_port": 993, "username": "u", "password": "pw-secret"},
     "users": ["admin", "user1"], "write": true},
    {"id": "mail.accounts.create.set_permissions", "route": "mail_accounts.create", "method": "POST", "path": "/api/mail_accounts/",
     "json": {"name": "parity-acc2", "imap_server": "x", "imap_port": 143, "username": "u", "password": "p",
              "set_permissions": {"view": {"users": [1, 1]}}},
     "users": ["admin"], "write": true},
    {"id": "mail.accounts.patch.stars", "route": "mail_accounts.partial_update", "method": "PATCH", "path": "/api/mail_accounts/${account_id}/",
     "json": {"name": "renamed", "password": "******"}, "users": ["admin", "user1", "user2"], "write": true, "requires": ["account_id"]},
    {"id": "mail.accounts.put.missing", "route": "mail_accounts.update", "method": "PUT", "path": "/api/mail_accounts/${account_id}/",
     "json": {"name": "x"}, "users": ["admin"], "write": true, "requires": ["account_id"]},
    {"id": "mail.accounts.delete", "route": "mail_accounts.destroy", "method": "DELETE", "path": "/api/mail_accounts/${account_id}/",
     "users": ["admin", "user1"], "write": true, "requires": ["account_id"]},
    {"id": "mail.accounts.test.invalid", "route": "mail_accounts.test", "method": "POST", "path": "/api/mail_accounts/test/",
     "json": {"imap_server": "127.0.0.1"}, "users": ["admin", "noperm"]},
    {"id": "mail.accounts.test.noperm", "route": "mail_accounts.test", "method": "POST", "path": "/api/mail_accounts/test/",
     "json": {"imap_server": "127.0.0.1", "imap_port": 9, "username": "u", "password": "p"}, "users": ["noperm"]},
    {"id": "mail.accounts.test.bad_id", "route": "mail_accounts.test", "method": "POST", "path": "/api/mail_accounts/test/",
     "json": {"id": "abc", "imap_server": "127.0.0.1", "imap_port": 9, "username": "u", "password": "p"}, "users": ["admin"]},
    {"id": "mail.accounts.test.refused", "route": "mail_accounts.test", "method": "POST", "path": "/api/mail_accounts/test/",
     "json": {"imap_server": "127.0.0.1", "imap_port": 9, "imap_security": 1, "username": "u", "password": "p"},
     "users": ["admin"], "compare": "status", "note": "Port 9 (discard) ist lokal geschlossen → upstream 500"},
    {"id": "mail.accounts.process", "route": "mail_accounts.process", "method": "POST", "path": "/api/mail_accounts/${account_id}/process/",
     "users": ["admin", "user1", "noperm"], "write": true, "requires": ["account_id"]},

    {"id": "mail.rules.create.invalid", "route": "mail_rules.create", "method": "POST", "path": "/api/mail_rules/",
     "json": {"name": "r", "account": 999999, "maximum_age": 9000000, "action": 7, "action_parameter": "",
              "assign_tags": "1", "assign_correspondent": "x", "order": 1.5, "pdf_layout": "9"},
     "users": ["admin", "user1"], "write": true},
    {"id": "mail.rules.create.action_param", "route": "mail_rules.create", "method": "POST", "path": "/api/mail_rules/",
     "json": {"name": "parity-rule", "account": "${account_id}", "action": 5},
     "users": ["admin"], "write": true, "requires": ["account_id"]},
    {"id": "mail.rules.create.ok", "route": "mail_rules.create", "method": "POST", "path": "/api/mail_rules/",
     "json": {"name": "parity-rule", "account": "${account_id}", "action": 2, "action_parameter": "Archive", "assign_tags": []},
     "users": ["admin", "user1"], "write": true, "requires": ["account_id"]},
    {"id": "mail.rules.patch", "route": "mail_rules.partial_update", "method": "PATCH", "path": "/api/mail_rules/${rule_id}/",
     "json": {"name": "Updated", "action": 1}, "users": ["admin", "user1", "user2"], "write": true, "requires": ["rule_id"]},
    {"id": "mail.rules.put.no_owner", "route": "mail_rules.update", "method": "PUT", "path": "/api/mail_rules/${rule_id}/",
     "json": {"name": "Updated", "account": "${account_id}"}, "users": ["admin", "user1"], "write": true, "requires": ["rule_id", "account_id"]},
    {"id": "mail.rules.delete", "route": "mail_rules.destroy", "method": "DELETE", "path": "/api/mail_rules/${rule_id}/",
     "users": ["admin", "user1"], "write": true, "requires": ["rule_id"]},

    {"id": "mail.processed.bulk_delete.bad", "route": "processed_mail.bulk_delete", "method": "POST", "path": "/api/processed_mail/bulk_delete/",
     "json": {"mail_ids": "not-a-list"}, "users": ["admin", "noperm"]},
    {"id": "mail.processed.bulk_delete.ok", "route": "processed_mail.bulk_delete", "method": "POST", "path": "/api/processed_mail/bulk_delete/",
     "json": {"mail_ids": ["${pm_id}", 999999]}, "users": ["admin", "user1", "user2"], "write": true, "requires": ["pm_id"]}
  ]
}

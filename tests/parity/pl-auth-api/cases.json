{
  "crate": "pl-auth-api",
  "defaults": {"users": ["admin"], "api_versions": ["10"]},
  "cases": [
    {"id": "auth.token.ok", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "json": {"username": "alice", "password": "alice"}, "write": true,
     "leak_allow": ["token"], "note": "successful login may rehash the password (salt length) -> write"},
    {"id": "auth.token.case-insensitive", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "form": {"username": "ALICE", "password": "alice"}, "write": true,
     "leak_allow": ["token"], "note": "allauth backend: username__iexact"},
    {"id": "auth.token.bad", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "json": {"username": "alice", "password": "nope"}},
    {"id": "auth.token.inactive", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "json": {"username": "dave", "password": "dave"}},
    {"id": "auth.token.form-code-blank", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "form": {"username": "x", "password": "y", "code": ""}},
    {"id": "auth.token.json-code-blank", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "json": {"username": "x", "password": "y", "code": ""}},
    {"id": "auth.token.unsupported-media", "route": "auth.token", "method": "POST", "path": "/api/token/",
     "users": ["anon"], "data": "username=x", "content_type": "text/plain"},

    {"id": "profile.patch.name", "route": "profile.patch", "method": "PATCH", "path": "/api/profile/",
     "users": ["user1", "user2"], "json": {"first_name": "Renamed", "last_name": ""}, "write": true,
     "leak_allow": ["token"]},
    {"id": "profile.patch.password", "route": "profile.patch", "method": "PATCH", "path": "/api/profile/",
     "users": ["user1"], "json": {"password": "a-Much-Better-Passw0rd"}, "write": true,
     "leak_allow": ["token"], "note": "session of the user becomes invalid (no update_session_auth_hash)"},
    {"id": "profile.generate_auth_token", "route": "profile.generate_auth_token", "method": "POST",
     "path": "/api/profile/generate_auth_token/", "users": ["user2"], "write": true, "compare": "status+headers"},
    {"id": "profile.totp.get", "route": "profile.totp.get", "method": "GET", "path": "/api/profile/totp/",
     "users": ["admin", "user1", "anon"], "compare": "status+headers", "note": "random secret"},
    {"id": "profile.totp.post.invalid", "route": "profile.totp.post", "method": "POST", "path": "/api/profile/totp/",
     "users": ["user1"], "json": {"secret": "JBSWY3DPEHPK3PXP", "code": "000000x"}},
    {"id": "profile.totp.delete.none", "route": "profile.totp.delete", "method": "DELETE", "path": "/api/profile/totp/",
     "users": ["user1", "anon"]},
    {"id": "profile.disconnect.missing", "route": "profile.disconnect_social_account", "method": "POST",
     "path": "/api/profile/disconnect_social_account/", "users": ["user1"], "form": {"id": "-1"}},

    {"id": "users.create.full", "route": "users.create", "method": "POST", "path": "/api/users/",
     "users": ["admin"], "write": true,
     "json": {"username": "newuser", "email": "new@example.org", "password": "Correct-Horse-9-Battery",
              "first_name": "New", "last_name": "User", "groups": [1], "user_permissions": ["view_document", "view_tag"]}},
    {"id": "users.create.form", "route": "users.create", "method": "POST", "path": "/api/users/",
     "users": ["admin"], "write": true, "form": {"username": "formuser"},
     "note": "html input: missing BooleanFields become False (is_active=false)"},
    {"id": "users.create.staff-by-nonsuperuser", "route": "users.create", "method": "POST", "path": "/api/users/",
     "users": ["user1"], "json": {"username": "x", "is_staff": "true"}},
    {"id": "users.partial_update.groups", "route": "users.partial_update", "method": "PATCH", "path": "/api/users/4/",
     "users": ["admin"], "write": true, "json": {"first_name": "Bobby", "groups": [1, 2], "user_permissions": []}},
    {"id": "users.update.put", "route": "users.update", "method": "PUT", "path": "/api/users/4/",
     "users": ["admin"], "write": true, "json": {"username": "bob", "email": "bob@example.org"}},
    {"id": "users.update.password-similar", "route": "users.partial_update", "method": "PATCH", "path": "/api/users/4/",
     "users": ["admin"], "json": {"password": "bobbob12"}},
    {"id": "users.deactivate_totp.none", "route": "users.deactivate_totp", "method": "POST",
     "path": "/api/users/3/deactivate_totp/", "users": ["admin", "user1", "noperm"]},

    {"id": "groups.create", "route": "groups.create", "method": "POST", "path": "/api/groups/",
     "users": ["admin"], "write": true, "json": {"name": "newgroup", "permissions": ["view_document", "add_tag"]}},
    {"id": "groups.partial_update", "route": "groups.partial_update", "method": "PATCH", "path": "/api/groups/2/",
     "users": ["admin"], "write": true, "json": {"permissions": ["view_tag"]}},
    {"id": "groups.update", "route": "groups.update", "method": "PUT", "path": "/api/groups/2/",
     "users": ["admin"], "write": true, "json": {"name": "renamed", "permissions": []}},
    {"id": "groups.destroy", "route": "groups.destroy", "method": "DELETE", "path": "/api/groups/2/",
     "users": ["admin"], "write": true,
     "steps": [
       {"method": "DELETE", "path": "/api/groups/2/"},
       {"method": "GET", "path": "/api/groups/"},
       {"method": "GET", "path": "/api/ui_settings/"}
     ]},

    {"id": "ui_settings.post.roundtrip", "route": "ui_settings.post", "method": "POST", "path": "/api/ui_settings/",
     "users": ["user1"], "write": true,
     "steps": [
       {"method": "POST", "path": "/api/ui_settings/",
        "json": {"settings": {"dark_mode": {"enabled": true}, "update_checking": {"enabled": false, "backend_setting": "x"}}}},
       {"method": "GET", "path": "/api/ui_settings/"}
     ]},
    {"id": "ui_settings.post.no-settings", "route": "ui_settings.post", "method": "POST", "path": "/api/ui_settings/",
     "users": ["user2"], "write": true, "json": {},
     "note": "stores settings=NULL; a following GET is a 500 upstream (None has no `in`)"},
    {"id": "ui_settings.post.not-dict", "route": "ui_settings.post", "method": "POST", "path": "/api/ui_settings/",
     "users": ["user1"], "json": {"settings": "x"}}
  ]
}

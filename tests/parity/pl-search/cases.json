{
  "crate": "pl-search",
  "vars": {
    "doc_id": {
      "get": "/api/documents/",
      "json": "results.0.id",
      "user": "admin",
      "query": {"ordering": "id", "page_size": 1, "fields": "id"}
    }
  },
  "defaults": {"users": ["admin", "user1"], "api_versions": ["10"]},
  "cases": [
    {"id": "search.documents.text", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"text": "invoice"}},
    {"id": "search.documents.text-two-tokens", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"text": "invoice 2023"}},
    {"id": "search.documents.title_search", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"title_search": "invoice"}},
    {"id": "search.documents.text-plus-query", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"text": "invoice", "query": "created:[-10 year to now]"}},
    {"id": "search.documents.too-many-params", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"text": "a", "title_search": "b"},
     "expect_status": [400]},
    {"id": "search.documents.query-ordering-created", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "invoice", "ordering": "-created"}},
    {"id": "search.documents.query-ordering-title", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "invoice", "ordering": "title"}},
    {"id": "search.documents.query-ordering-score-asc", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "invoice", "ordering": "score"}},
    {"id": "search.documents.query-fields", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "tag:inbox OR type:invoice OR correspondent:bank"}},
    {"id": "search.documents.query-notes", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "notes:payment"}},
    {"id": "search.documents.query-wildcard", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "inv*"}},
    {"id": "search.documents.query-bad-number", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "asn:abc"}, "expect_status": [400]},
    {"id": "search.documents.query-text-range", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "title:[a TO c]"}},
    {"id": "search.documents.query-too-long", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": ""},
     "expect_status": [400]},
    {"id": "search.documents.more_like-page", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"more_like_id": "{doc_id}", "page_size": 2}},
    {"id": "search.documents.query-selection-data", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "invoice", "include_selection_data": "true"}},
    {"id": "search.documents.query-page-last", "route": "search.list", "method": "GET",
     "path": "/api/documents/", "query": {"query": "invoice", "page": "last", "page_size": 1}},
    {"id": "search.autocomplete.unicode", "route": "search.autocomplete", "method": "GET",
     "path": "/api/search/autocomplete/", "query": {"term": "STRA"},
     "users": ["admin", "user1", "noperm"]},
    {"id": "search.autocomplete.limit-zero", "route": "search.autocomplete", "method": "GET",
     "path": "/api/search/autocomplete/", "query": {"term": "a", "limit": "0"},
     "expect_status": [400]},
    {"id": "search.global.db_only-false-is-truthy", "route": "search.global", "method": "GET",
     "path": "/api/search/", "query": {"query": "inv", "db_only": "false"}},
    {"id": "search.global.text", "route": "search.global", "method": "GET",
     "path": "/api/search/", "query": {"query": "invoice"},
     "users": ["admin", "user1", "noperm"]}
  ]
}

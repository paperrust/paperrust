# Repo-Hygiene (R3, 2026-11-09): keine Programme, Prozess-IDs oder Rohdaten von Messläufen.
# Berichte (*.md, summary.json, latest.json) bleiben versionierbar.
/results/bin/
*.exe
*.pdb
*.pid
/results/parity/**/2026-*.json
/results/e2e/**/A/
/results/e2e/**/B/
/results/e2e/**/diff/
# lokale Datenbanken, Dumps, Sicherungen
*.pgdump
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# Konfiguration mit Geheimnissen
paperless.conf
paperrust.conf
# Arbeitsordner der Tests
/tests/dbmigrate/.work/
/tests/datamodel/.work/
/results/desktop/
/results/pack/
/scratchpad/
tests/parity/.w2*/
/apps/desktop-shell/target/
/results/static/


# Build-Kontext für docker/Dockerfile (BuildKit liest <Dockerfile>.dockerignore vor .dockerignore).
# Kontext ist die Repo-Wurzel. Ziel: klein und ohne Geheimnisse/lokale Daten.

# Build-Ausgaben, Messläufe, lokale Referenzumgebung (Datenbank, venv, Dokumente)
target
target-*
results
reference
tests
**/node_modules
frontend-light/dist

# Desktop-Hülle (eigener Workspace, im Server-Image nicht gebraucht) und Paketbau
apps/desktop-shell
apps/desktop/pack

# upstream: nur src/documents/static, src/documents/resources und LICENSE werden kopiert
upstream/.git
upstream/docs
upstream/src-ui
upstream/src/**/tests
upstream/src/paperless_testing

# Git, Editor, Geheimnisse
.git
**/.git
.github
.env
**/*.env
paperless.conf
paperrust.conf
**/*.pgdump
**/*.sqlite3
**/*.log
**/*.pid
**/*.exe
**/*.pdb
**/__pycache__

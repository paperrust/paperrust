<?xml version="1.0"?>
<!--
  PaperRust – Unraid-Vorlage (Community Applications / Docker-Tab "Add Container" -> Template).
  Braucht einen PostgreSQL-Container (Vorlage paperrust-postgres.xml oder einen vorhandenen).
  Nutzung ohne CA-Eintrag: Datei nach /boot/config/plugins/dockerMan/templates-user/my-paperrust.xml
  kopieren, dann Docker -> Add Container -> Template "paperrust". Anleitung: docker/nas/README.md
  Image-Name: docker/nas/set-image.sh <image> ändert alle NAS-Vorlagen auf einmal.
-->
<Container version="2">
  <Name>paperrust</Name>
  <Repository>ghcr.io/paperrust/paperrust:latest</Repository>
  <Registry>https://github.com/paperrust/paperrust/pkgs/container/paperrust</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/paperrust/paperrust/issues</Support>
  <Project>https://github.com/paperrust/paperrust</Project>
  <Overview>PaperRust: schneller, schlanker Ersatz für paperless-ngx (kompatibel zu v3.4.2, gleiche Oberfläche, gleiche API, gleiche Datenbank). Ein Container statt fünf: kein Redis, kein Tika, kein Gotenberg – nur PostgreSQL wird gebraucht. Dokumente scannen, OCR (Tesseract), Volltextsuche, Tags, Workflows, Mail-Abruf.&#xD;
&#xD;
Fast, lean drop-in replacement for paperless-ngx (v3.4.2 compatible: same UI, API and database). One container instead of five – only PostgreSQL is required.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/paperrust/paperrust/main/docs/design/assets/png/icon-512.png</Icon>
  <!-- Startet als root, übernimmt PUID/PGID und gibt die Rechte danach ab (setpriv). -->
  <ExtraParams>--user 0:0 --stop-timeout 45</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>PostgreSQL 14 oder neuer (z. B. Vorlage paperrust-postgres). / PostgreSQL 14+ required.</Requires>
  <Config Name="WebUI-Port" Target="8000" Default="8000" Mode="tcp" Description="Port der Weboberfläche / web UI port" Type="Port" Display="always" Required="true" Mask="false">8000</Config>
  <Config Name="Data" Target="/usr/src/paperless/data" Default="/mnt/user/appdata/paperrust/data" Mode="rw" Description="Suchindex, Klassifikator, Protokolle / index, classifier, logs" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/paperrust/data</Config>
  <Config Name="Media" Target="/usr/src/paperless/media" Default="/mnt/user/appdata/paperrust/media" Mode="rw" Description="Dokumente (Originale, Archiv, Vorschaubilder) / documents" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/paperrust/media</Config>
  <Config Name="Consume" Target="/usr/src/paperless/consume" Default="/mnt/user/appdata/paperrust/consume" Mode="rw" Description="Eingangsordner (Scanner) / consumption folder" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/paperrust/consume</Config>
  <Config Name="Export" Target="/usr/src/paperless/export" Default="/mnt/user/appdata/paperrust/export" Mode="rw" Description="Ziel für document_exporter (Sicherung) / backup export" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/paperrust/export</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Benutzer-ID der Dateien (Unraid: 99 = nobody) / file owner UID" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Gruppen-ID der Dateien (Unraid: 100 = users) / file owner GID" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="Secret key" Target="PAPERRUST_SECRET_KEY" Default="" Mode="" Description="Lange Zufallszeichenkette (beim Umstieg von paperless-ngx denselben Wert) / long random string" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="DB host" Target="PAPERRUST_DBHOST" Default="" Mode="" Description="IP oder Name des PostgreSQL-Containers (z. B. Unraid-IP, Port unten) / PostgreSQL host" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="DB port" Target="PAPERRUST_DBPORT" Default="5432" Mode="" Description="PostgreSQL-Port" Type="Variable" Display="advanced" Required="true" Mask="false">5432</Config>
  <Config Name="DB name" Target="PAPERRUST_DBNAME" Default="paperless" Mode="" Description="Datenbank" Type="Variable" Display="advanced" Required="true" Mask="false">paperless</Config>
  <Config Name="DB user" Target="PAPERRUST_DBUSER" Default="paperless" Mode="" Description="Datenbank-Benutzer" Type="Variable" Display="advanced" Required="true" Mask="false">paperless</Config>
  <Config Name="DB password" Target="PAPERRUST_DBPASS" Default="" Mode="" Description="Datenbank-Passwort (wie im PostgreSQL-Container)" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Admin user" Target="PAPERRUST_ADMIN_USER" Default="admin" Mode="" Description="Erster Administrator (wird angelegt, falls er fehlt)" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="Admin password" Target="PAPERRUST_ADMIN_PASSWORD" Default="" Mode="" Description="Passwort des ersten Administrators" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Time zone" Target="PAPERRUST_TIME_ZONE" Default="Europe/Berlin" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
  <Config Name="OCR language" Target="PAPERRUST_OCR_LANGUAGE" Default="deu+eng" Mode="" Description="Tesseract-Sprachen (im Image: eng deu fra ita spa)" Type="Variable" Display="advanced" Required="false" Mask="false">deu+eng</Config>
  <Config Name="Consumer polling" Target="PAPERRUST_CONSUMER_POLLING_INTERVAL" Default="10" Mode="" Description="Eingangsordner alle N s abfragen (Unraid-Freigaben melden Änderungen nicht zuverlässig)" Type="Variable" Display="advanced" Required="false" Mask="false">10</Config>
  <Config Name="Public URL" Target="PAPERRUST_URL" Default="" Mode="" Description="Adresse hinter Reverse Proxy, z. B. https://paperrust.example.com" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>

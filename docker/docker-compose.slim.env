# Schlanke Umgebung für docker-compose.slim.yml: nur Startwerte (Klasse C in docs/SETTINGS.md).
# Alles andere wird in der Oberfläche eingestellt (Einstellungen → System) und in der Datenbank
# gespeichert. Statt PAPERRUST_* gehen auch die Namen von paperless-ngx (PAPERLESS_*).
# Referenz: docs/user/configuration.md
#
# Diese Datei enthält keine echten Geheimnisse. Für den Betrieb kopieren und anpassen; die Kopie
# nicht versionieren.

# Datenbank (Dienst `db` in docker-compose.slim.yml). DBENGINE=postgresql folgt aus DBHOST,
# DBNAME/DBUSER sind „paperless“. Passwort = POSTGRES_PASSWORD des db-Dienstes.
PAPERRUST_DBHOST=db
PAPERRUST_DBPASS=paperless

# Pflicht: lange Zufallszeichenkette, z. B. `openssl rand -base64 48`. Beim Umstieg von
# paperless-ngx DENSELBEN Wert übernehmen (Sitzungen, Freigabelinks, verschlüsselte Felder).
# Er ist auch der Schlüssel für die in der Datenbank verschlüsselten Einstellungs-Geheimnisse
# (SMTP-Passwort, OAuth-Secrets …): nach einer Änderung
# `paperrust manage settings rekey --old-secret-key <ALT>` ausführen.
PAPERRUST_SECRET_KEY=change-me

# Nur hinter einem Reverse Proxy schon vor der ersten Anmeldung nötig (CSRF-Origin); sonst später
# in der Oberfläche (Einstellungen → System → Netzwerk & Sicherheit).
#PAPERRUST_URL=https://paperrust.example.com

# Optional: ersten Administrator beim ersten Start anlegen (danach entfernen) – oder
# `docker compose -f docker-compose.slim.yml exec paperrust createsuperuser`.
#PAPERRUST_ADMIN_USER=admin
#PAPERRUST_ADMIN_PASSWORD=change-me
